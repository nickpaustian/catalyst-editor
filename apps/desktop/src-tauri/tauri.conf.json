{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Catalyst",
  "version": "0.1.0",
  "identifier": "au.nickpaustian.catalyst",
  "build": {
    "frontendDist": "../../editor/dist",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "npm run dev --prefix ../editor",
    "beforeBuildCommand": "npm run build --prefix ../editor"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Catalyst",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
