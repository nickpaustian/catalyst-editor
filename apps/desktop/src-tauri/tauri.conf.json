{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Catalyst",
  "version": "0.1.0",
  "identifier": "au.nickpaustian.catalyst",
  "build": {
    "frontendDist": "../../editor/dist",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "npm run dev --prefix ../editor",
    "beforeBuildCommand": "npm run build --prefix ../editor"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Catalyst",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 23 }
      },
      {
        "label": "start",
        "url": "start.html",
        "title": "Catalyst",
        "width": 760,
        "height": 520,
        "resizable": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "catalyst"
        ],
        "name": "Catalyst project",
        "description": "A Catalyst project",
        "role": "Editor",
        "mimeType": "application/x-catalyst-project"
      }
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
