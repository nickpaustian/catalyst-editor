{
  "$schema-note": "Catalyst editor design tokens. The one copy to edit: tokens.css and tokens.ts are written from it by scripts/tokens.mjs (npm run tokens). Dark theme only (v1).",
  "version": "1.0.0",

  "color": {
    "bg": {
      "app":        { "value": "#0E0F12", "use": "Window background, title bar, inset wells (segmented control track), focused field well" },
      "viewport":   { "value": "#111216", "use": "3D viewport clear colour behind the grid" },
      "panel":      { "value": "#16171B", "use": "Panel body" },
      "raised":     { "value": "#1C1D22", "use": "Panel headers, menus, popovers, disabled field well" },
      "field":      { "value": "#22242A", "use": "Inputs, wells, secondary button" },
      "hover":      { "value": "#2A2C33", "use": "Row / button / menu-item hover; keyboard-highlighted option" },
      "active":     { "value": "#33363E", "use": "Pressed; selected segment; selection when its panel is unfocused; tag chips" }
    },
    "text": {
      "primary":    { "value": "#E6E7EA", "use": "Names, values, titles. 14.3:1 on bg.panel" },
      "secondary":  { "value": "#A3A7B0", "use": "Property labels, body copy in panels. 7.4:1" },
      "tertiary":   { "value": "#8A8E98", "use": "Hints, type badges, units, placeholders. 5.4:1 — floor for readable text" },
      "disabled":   { "value": "#5C606A", "use": "Unavailable controls only. 2.8:1 (exempt)" },
      "onAccent":   { "value": "#0E0F12", "use": "Text on accent fills (primary button). 6.5:1 on accent" }
    },
    "border": {
      "subtle":     { "value": "#24262C", "use": "Dividers inside a panel" },
      "default":    { "value": "#2F3239", "use": "Field outlines, panel seams, menu outlines" },
      "strong":     { "value": "#464A54", "use": "Hovered field/button outline, empty-slot dashed outline" }
    },
    "accent": {
      "default":    { "value": "#FF4FC8", "use": "Hot pink. Selected / focused / active ONLY (+ primary button fill). Also the logo flame." },
      "soft":       { "value": "#FF4FC829", "use": "Selected row fill, active tool fill, valid drop target fill (16% alpha)" },
      "ring":       { "value": "#FF4FC866", "use": "Keyboard focus ring (40% alpha)" }
    },
    "status": {
      "success":         { "value": "#5FCB8A", "use": "Scripts built, saved, Run icon" },
      "warning":         { "value": "#F2B451", "use": "Play mode, warnings, key-binding conflicts" },
      "warningSurface":  { "value": "#2B2416" },
      "warningBorder":   { "value": "#6B5320" },
      "danger":          { "value": "#F2696B", "use": "Errors, invalid fields, destructive actions, missing references" },
      "dangerSurface":   { "value": "#2E1F22", "use": "Danger button hover" },
      "dangerSurfacePressed": { "value": "#3A2427" },
      "dangerBorder":    { "value": "#6B3337" },
      "dangerTextPressed": { "value": "#F58A8B" },
      "info":            { "value": "#6FA8FF", "use": "Logs, hints, instance-override marker" }
    },
    "axis": {
      "x": { "value": "#FF6B6B" },
      "y": { "value": "#7BD88F" },
      "z": { "value": "#6FA8FF" },
      "w": { "value": "#A3A7B0", "use": "4th component has no axis colour" }
    },
    "anim": {
      "key":         { "value": "#F2B451", "use": "Keyframe diamond (filled = key on this frame, hollow = animated between keys)" },
      "keySurface":  { "value": "#2B2416", "use": "Field well when on a key" },
      "keyBorder":   { "value": "#6B5320", "use": "Field outline when animated" }
    },
    "override":  { "value": "#6FA8FF", "use": "Dot + revert button for values overridden in a scene instance" },
    "changed":   { "value": "#A3A7B0", "use": "4px dot before a label whose value differs from the default" },
    "logo": {
      "pink":        { "value": "#FF4FC8", "use": "Flame on dark (= accent)" },
      "pinkOnLight": { "value": "#E62DAE", "use": "Flame on light backgrounds" },
      "ink":         { "value": "#141414", "use": "Dark brand background; text on light; flame on the pink app icon" },
      "bone":        { "value": "#F3F1EC", "use": "Wordmark on dark; light brand background" },
      "stoneCap":    { "value": "#F4F2EE", "use": "Obelisk top face (full-colour mark)" },
      "stoneFront":  { "value": "#D9D5CC", "use": "Obelisk front face (full-colour mark)" },
      "stoneSide":   { "value": "#8F8C86", "use": "Obelisk side face (full-colour mark)" }
    },
    "overlay": {
      "viewportChrome": { "value": "rgba(22,23,27,0.88)", "use": "Floating toolbars over the viewport" },
      "checkerA": { "value": "#46484F", "use": "Transparency checkerboard" },
      "checkerB": { "value": "#2A2C33" },
      "scrim": { "value": "rgba(8,9,11,0.6)", "use": "Behind modal dialogs" }
    }
  },

  "font": {
    "family": {
      "ui":   { "value": "Geist, ui-sans-serif, system-ui, sans-serif" },
      "mono": { "value": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "style": {
      "titleDialog":  { "family": "ui",   "size": 15, "lineHeight": 20, "weight": 600 },
      "titlePanel":   { "family": "ui",   "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": "0.01em", "note": "Sentence case — not all caps" },
      "labelSection": { "family": "ui",   "size": 11, "lineHeight": 16, "weight": 600, "letterSpacing": "0.06em", "textTransform": "uppercase" },
      "body":         { "family": "ui",   "size": 12, "lineHeight": 18, "weight": 400 },
      "bodyStrong":   { "family": "ui",   "size": 12, "lineHeight": 18, "weight": 500 },
      "bodySmall":    { "family": "ui",   "size": 11, "lineHeight": 16, "weight": 400 },
      "nodeNameEdit": { "family": "ui",   "size": 13, "lineHeight": 18, "weight": 500, "note": "Inspector node-name field" },
      "monoValue":    { "family": "mono", "size": 12, "lineHeight": 16, "weight": 400, "fontVariantNumeric": "tabular-nums" },
      "monoSmall":    { "family": "mono", "size": 11, "lineHeight": 16, "weight": 400, "note": "Type badges, shortcuts, key caps, indices" },
      "monoAxis":     { "family": "mono", "size": 11, "lineHeight": 16, "weight": 500, "note": "X/Y/Z letters in vector cells (10px in narrow inspector)" },
      "monoCode":     { "family": "mono", "size": 13, "lineHeight": 20, "weight": 400 }
    }
  },

  "space": { "0.5": 2, "1": 4, "1.5": 6, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32 },

  "radius": { "xs": 3, "sm": 4, "md": 6, "lg": 10, "pill": 999 },

  "size": {
    "control": { "xs": 20, "sm": 24, "md": 28, "lg": 32 },
    "row":            24,
    "menuItem":       26,
    "panelHeader":    32,
    "sectionHeader":  28,
    "titleBar":       44,
    "treeIndent":     18,
    "labelColumn":    112,
    "labelColumnNarrow": 72,
    "rowGap":         4,
    "labelGap":       8,
    "checkbox":       14,
    "switchW":        26,
    "switchH":        14,
    "icon":           16,
    "iconSm":         14,
    "iconXs":         12,
    "axisCell":       18, "axisCellNarrow": 14,
    "dropIndicator":  2
  },

  "shadow": {
    "e0": { "value": "none", "use": "Panels — seam only" },
    "e1": { "value": "0 4px 12px rgba(0,0,0,0.35)", "use": "Menus, tooltips, popovers, viewport overlays" },
    "e2": { "value": "0 16px 40px rgba(0,0,0,0.55)", "use": "Dialogs, command palette" },
    "focus": { "value": "0 0 0 2px var(--cat-bg-panel), 0 0 0 4px var(--cat-accent-ring)", "use": "Keyboard focus (:focus-visible) on buttons" }
  },

  "motion": {
    "$status": "PROPOSED — not yet designed on the canvas. Treat as defaults until reviewed.",
    "duration": { "instant": 0, "fast": 80, "base": 140, "slow": 220 },
    "easing":   { "standard": "cubic-bezier(0.2, 0, 0, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" },
    "tooltipDelay": 500
  }
}
