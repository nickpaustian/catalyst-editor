{
  "name": "catalyst-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/player && vite --host",
    "dev:editor": "npm run dev --prefix apps/editor",
    "dev:desktop": "cd apps/desktop && tauri dev",
    "build:desktop": "cd apps/desktop && tauri build",
    "build": "cd apps/player && tsc && vite build",
    "build:editor": "npm run build --prefix apps/editor",
    "preview": "cd apps/player && vite preview",
    "typecheck": "cd apps/editor && tsc && cd ../player && tsc",
    "tokens": "node scripts/tokens.mjs",
    "link:engine": "npm install --no-save ../catalyst ../obelisk/packages/obelisk",
    "unlink": "npm ci",
    "build:wasm": "cd packages/stelligra/stelligra-wasm && wasm-pack build --target web --release"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "sass": "^1.93.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.3"
  }
}
